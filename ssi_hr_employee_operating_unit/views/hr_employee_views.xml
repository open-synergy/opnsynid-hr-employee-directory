<odoo>

<!-- FORM VIEW -->
<record id="hr_employee_view_form" model="ir.ui.view">
    <field name="name">hr.employee: Operating Unit Form</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="ssi_hr_employee.hr_employee_view_form" />
    <field name="priority" eval="30" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='organization_unit_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
        </data>
    </field>
</record>

<!-- TREE VIEW -->
<record id="hr_employee_view_tree" model="ir.ui.view">
    <field name="name">hr.employee: Operating Unit Tree</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_tree" />
    <field name="priority" eval="30" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='department_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                        optional="hide"
                    />
            </xpath>
        </data>
    </field>
</record>

<!-- SEARCH VIEW -->
<record id="hr_employee_view_search" model="ir.ui.view">
    <field name="name">hr.employee: Operating Unit Search</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_filter" />
    <field name="priority" eval="30" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//group[@expand='0']" position="inside">
                <filter
                        name="grp_ou"
                        string="Operating Unit"
                        context="{'group_by':'operating_unit_id'}"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
            <xpath expr="//searchpanel/field[@name='department_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                        icon="fa-sitemap"
                        enable_counters="1"
                    />
            </xpath>
        </data>
    </field>
</record>

</odoo>
